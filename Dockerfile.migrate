FROM node:24-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
COPY prisma.config.ts ./
COPY src/lib/prisma.js ./src/lib/prisma.js
COPY scripts/check-db.mjs ./scripts/check-db.mjs
COPY src/lib/cinemaImport.mjs ./src/lib/cinemaImport.mjs
COPY scripts/sync-cinema.mjs ./scripts/sync-cinema.mjs
COPY src/lib/cinemaPosterPolicy.mjs ./src/lib/cinemaPosterPolicy.mjs
COPY src/lib/cinemaPosters.mjs ./src/lib/cinemaPosters.mjs
COPY scripts/sync-cinema-posters.mjs ./scripts/sync-cinema-posters.mjs
COPY scripts/cinema-worker.mjs ./scripts/cinema-worker.mjs
COPY src/lib/cinemaPosterTransform.mjs ./src/lib/cinemaPosterTransform.mjs
COPY src/lib/cinemaSyncPolicy.mjs ./src/lib/cinemaSyncPolicy.mjs
COPY src/lib/media/s3.js ./src/lib/media/s3.js

RUN DATABASE_URL="postgresql://dummy:dummy@127.0.0.1:5432/dummy" \
    ./node_modules/.bin/prisma generate

CMD ["./node_modules/.bin/prisma", "migrate", "deploy"]
