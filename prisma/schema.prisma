generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AdStatus {
  DRAFT
  PENDING
  APPROVED
  PUBLISHED
  REJECTED
  PAUSED
  CLOSED
  EXPIRED
}

model User {
  id    String   @id @default(cuid())
  email String?  @unique @db.VarChar(254)
  emailVerifiedAt DateTime?
  displayName String? @db.VarChar(80)
  phone String?  @unique @db.VarChar(24)
  role  UserRole @default(USER)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ads ClassifiedAd[]
  sessions UserSession[]
  newsPosts NewsPost[] @relation("NewsPostCreatedBy")
  eventPosts EventPost[] @relation("EventCreatedBy")
  officialNotices OfficialNotice[] @relation("OfficialNoticeCreatedBy")
  officialDocuments OfficialDocument[] @relation("OfficialDocumentCreatedBy")
  serviceAlerts ServiceAlert[] @relation("ServiceAlertCreatedBy")
  orgClaims OrgClaim[] @relation("OrgClaimRequester")
  orgEditProposals OrgEditProposal[] @relation("OrgEditProposalRequester")
  newsWorkflowEvents NewsWorkflowEvent[] @relation("NewsWorkflowActor")
  newsComments NewsComment[] @relation("NewsCommentAuthor")
  moderatedNewsComments NewsComment[] @relation("NewsCommentModerator")
  newsCommentEvents NewsCommentEvent[] @relation("NewsCommentEventActor")
  newsCommentReports NewsCommentReport[] @relation("NewsCommentReporter")
}

model ClassifiedAd {
  id   String  @id @default(cuid())
  slug String? @unique


  moderationReason String?   @db.VarChar(500)
  moderatedAt      DateTime?
  moderatedById    String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  title        String @db.VarChar(120)
  category     String @db.VarChar(32)
  description  String @db.Text
  priceRub     Int?
  location     String @db.VarChar(120)
  contactPhone String @db.VarChar(24)

  status AdStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  expiresAt   DateTime?
  closedAt    DateTime?

  photos AdPhoto[]

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([status, category])
}

model AdPhoto {
  id         String @id @default(cuid())
  adId       String
  storageKey String @db.VarChar(512)
  sortOrder  Int    @default(0)

  ad ClassifiedAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, sortOrder])
}
model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


// CMS: public news continues reading Markdown until the separate migration phase.
enum NewsStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  UNPUBLISHED
  TRASHED
}

enum NewsWorkflowAction {
  SUBMITTED
  RETURNED
  APPROVED
  REOPENED
  PUBLISHED
  UNPUBLISHED
  REPUBLISHED
}

enum NewsSourceKind {
  OWN
  OFFICIAL
  PRESS_RELEASE
  THIRD_PARTY
  OTHER
}

model NewsPost {
  id             String     @id @default(cuid())
  slug           String     @unique @db.VarChar(160)
  title          String     @db.VarChar(180)
  summary        String     @default("") @db.VarChar(600)
  body           String     @db.Text
  status         NewsStatus @default(DRAFT)
  category       String     @default("город") @db.VarChar(48)
  authorName     String     @default("Редакция Поток 96") @db.VarChar(120)
  orgSlug        String?    @db.VarChar(160)
  tags           String[]   @default([])
  crosspost      String[]   @default([])
  cover          String?    @db.VarChar(512)
  featured       Boolean    @default(false)
  featuredOrder  Int        @default(99)
  sourceName     String?    @db.VarChar(180)
  sourceUrl      String?    @db.VarChar(2048)
  sourceText     String?    @db.Text
  sourceKind     NewsSourceKind @default(OWN)
  rightsNote     String?    @db.VarChar(2000)
  coverImageId   String?    @db.VarChar(36)
  images         NewsImage[]
  workflowEvents NewsWorkflowEvent[]
  comments       NewsComment[]
  commentsEnabled Boolean @default(false)
  createdById    String?
  createdBy      User?      @relation("NewsPostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  trashedAt      DateTime?  @db.Timestamptz(3)
  trashedById    String?    @db.VarChar(100)
  purgeStartedAt DateTime? @db.Timestamptz(3)
  publishedAt    DateTime?

  @@index([status, publishedAt])
  @@index([updatedAt])
  @@index([trashedAt])
  @@index([createdById, createdAt])
}


// Stage 5.13: premoderated discussion on CMS news only.
enum NewsCommentStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  DELETED
}

enum NewsCommentAction {
  APPROVE
  REJECT
  HIDE
  DELETE
}

model NewsComment {
  id             String @id @default(cuid())
  postId         String
  authorId       String
  parentId       String?
  body           String @db.Text
  status         NewsCommentStatus @default(PENDING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  moderatedById  String?
  moderatedAt    DateTime?
  moderationNote String? @db.VarChar(500)

  post      NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User @relation("NewsCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  moderator User? @relation("NewsCommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  parent    NewsComment? @relation("NewsCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   NewsComment[] @relation("NewsCommentReplies")
  events    NewsCommentEvent[]
  reports   NewsCommentReport[]

  @@index([postId, status, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId, status, createdAt])
}

model NewsCommentEvent {
  id         String @id @default(cuid())
  commentId  String
  actorId    String?
  action     NewsCommentAction
  fromStatus NewsCommentStatus
  toStatus   NewsCommentStatus
  note       String? @db.VarChar(500)
  createdAt  DateTime @default(now())

  comment NewsComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  actor User? @relation("NewsCommentEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([commentId, createdAt])
}

model NewsCommentReport {
  id        String @id @default(cuid())
  commentId String
  userId    String
  reason    String @db.VarChar(500)
  createdAt DateTime @default(now())

  comment NewsComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user User @relation("NewsCommentReporter", fields: [userId], references: [id], onDelete: Restrict)
  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId, createdAt])
}

// Private news draft images. Public CDN promotion happens in stage 5.3.
model NewsImage {
  id         String   @id @db.VarChar(36)
  postId     String
  storageKey String   @db.VarChar(512)
  sortOrder  Int      @default(0)
  caption    String?  @db.VarChar(240)
  credit     String?  @db.VarChar(240)
  rightsNote String?  @db.VarChar(1000)
  createdAt  DateTime @default(now())
  post       NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

// Record each editorial decision without publishing the article.
model NewsWorkflowEvent {
  id        String             @id @default(cuid())
  postId    String
  actorId   String?
  action    NewsWorkflowAction
  note      String?            @db.VarChar(1000)
  createdAt DateTime           @default(now())

  post      NewsPost           @relation(fields: [postId], references: [id], onDelete: Cascade)
  actor     User?              @relation("NewsWorkflowActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
}

// Immutable journal of administrator role changes. IDs remain after account deletion.
model AdminRoleChange {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String
  oldRole   UserRole
  newRole   UserRole
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([createdAt])
}

// Immutable audit of account session/grant revocations performed by ADMIN.
model AdminSessionRevocation {
  id           String   @id @default(cuid())
  actorId      String
  targetId     String
  revokedCount Int
  createdAt    DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([createdAt])
}

// A phone-only invitation does not give permissions until verified Mobile ID login.
// Keep audit IDs as strings, not foreign keys, for historical accuracy.
model StaffInvitation {
  id           String   @id @default(cuid())
  phone        String   @db.VarChar(24)
  createdById  String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?
  revokedAt    DateTime?
  acceptedById String?

  @@index([phone, createdAt])
  @@index([createdAt])
}

// Immutable audit of user archival/restoration; actor/target IDs outlive accounts.
model AdminUserArchive {
  id           String   @id @default(cuid())
  actorId      String
  targetId     String
  action       String   @db.VarChar(12)
  revokedCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([createdAt])
}

// Stage 5.6.1: PostgreSQL-backed organization cards; legacy Markdown remains read-only.
enum OrgStatus {
  DRAFT
  PUBLISHED
}

// Stage 5.6.3: optional extended placement. Effective access requires a future date.
enum OrgPlacement {
  BASIC
  EXTENDED
}

model Organization {
  id           String   @id @default(cuid())
  slug         String   @unique @db.VarChar(160)
  title        String   @db.VarChar(160)
  type         String   @default("") @db.VarChar(120)
  category     String   @default("other") @db.VarChar(32)
  area         String   @default("city") @db.VarChar(12)
  locality     String   @default("Красноуфимск") @db.VarChar(120)
  address      String   @default("") @db.VarChar(240)
  phone        String   @default("") @db.VarChar(100)
  hours        String   @default("") @db.VarChar(600)
  tags         String[] @default([])
  services     String[] @default([])
  website      String   @default("") @db.VarChar(2048)
  email        String   @default("") @db.VarChar(254)
  mapUrl       String   @default("") @db.VarChar(2048)
  vkUrl        String   @default("") @db.VarChar(2048)
  okUrl        String   @default("") @db.VarChar(2048)
  maxUrl       String   @default("") @db.VarChar(2048)
  logo         String   @default("") @db.VarChar(512)
  cover        String   @default("") @db.VarChar(512)
  logoImageId  String?  @db.VarChar(36)
  coverImageId String?  @db.VarChar(36)
  images       OrgImage[]
  orgClaims    OrgClaim[]
  orgEditProposals OrgEditProposal[]
  content      String   @default("") @db.Text
  status       OrgStatus @default(DRAFT)
  placement    OrgPlacement @default(BASIC)
  extendedUntil DateTime?
  priceItems    Json @default("[]")
  specialOffers Json @default("[]")
  extraLinks    Json @default("[]")
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  publishedAt  DateTime?

  @@index([status, title])
  @@index([category, area])
  @@index([placement, extendedUntil])
}

// Stage 5.6.2: original and responsive versions are private until publication.
model OrgImage {
  id         String   @id @db.VarChar(36)
  orgId      String
  storageKey String   @db.VarChar(512)
  sortOrder  Int      @default(0)
  caption    String?  @db.VarChar(240)
  credit     String?  @db.VarChar(240)
  rightsNote String?  @db.VarChar(1000)
  createdAt  DateTime @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, sortOrder])
}

// Stage 5.6.5a: representative claims are reviewed manually.
// An approved claim grants NO moderator or administrator role.
enum OrgClaimStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model OrgClaim {
  id              String         @id @default(cuid())
  orgId           String
  requesterId     String
  roleDescription String         @db.VarChar(120)
  evidenceNote    String         @db.VarChar(1000)
  status          OrgClaimStatus @default(PENDING)
  reviewNote      String?        @db.VarChar(500)
  reviewedById    String?
  reviewedAt      DateTime?
  revocationNote  String?        @db.VarChar(500)
  revokedById     String?
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  requester    User         @relation("OrgClaimRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  editProposals OrgEditProposal[]

  @@index([status, createdAt])
  @@index([requesterId, createdAt])
  @@index([orgId, status])
}

// Stage 5.6.5b1: drafts and proposals are separate from publicly visible cards.
// Review and application to the public card are deferred to stage 5.6.5b2.
enum OrgEditProposalStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  REJECTED
  CANCELLED
}

model OrgEditProposal {
  id                String @id @default(cuid())
  orgId             String
  requesterId       String
  claimId           String
  status            OrgEditProposalStatus @default(DRAFT)
  baseOrgUpdatedAt  DateTime
  baseFields        Json
  fields            Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewNote        String? @db.VarChar(1000)
  reviewEvents      OrgProposalReviewEvent[]

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  requester    User         @relation("OrgEditProposalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  claim        OrgClaim     @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@index([requesterId, createdAt])
  @@index([orgId, status])
  @@index([status, submittedAt])
}

// Stage 5.6.5b2: immutable audit of editorial decisions; never discard history on resubmission.
model OrgProposalReviewEvent {
  id         String @id @default(cuid())
  proposalId String
  reviewerId String
  action     String @db.VarChar(16)
  note       String @db.VarChar(1000)
  createdAt  DateTime @default(now())

  proposal   OrgEditProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  @@index([proposalId, createdAt])
}

// Stage 5.7.1: new events live in PostgreSQL; legacy Markdown stays read-only.
enum EventStatus {
  DRAFT
  PUBLISHED
  TRASHED
}

model EventPost {
  id              String @id @default(cuid())
  slug            String @unique @db.VarChar(160)
  title           String @db.VarChar(180)
  category        String @default("other") @db.VarChar(32)
  startAt         DateTime
  endAt           DateTime?
  location        String @default("") @db.VarChar(240)
  price           String @default("") @db.VarChar(80)
  isFree          Boolean @default(false)
  pushkinCard     Boolean @default(false)
  pushkinProofUrl String @default("") @db.VarChar(2048)
  summary         String @default("") @db.VarChar(600)
  cover           String @default("") @db.VarChar(512)
  coverImageId    String? @db.VarChar(36)
  orgSlug         String @default("") @db.VarChar(160)
  video           String @default("") @db.VarChar(2048)
  content         String @default("") @db.Text
  status          EventStatus @default(DRAFT)
  createdById     String
  createdBy       User @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  trashedAt       DateTime? @db.Timestamptz(3)
  trashedById     String?   @db.VarChar(100)
  purgeStartedAt DateTime? @db.Timestamptz(3)
  publishedAt     DateTime?
  images          EventImage[]

  @@index([status, startAt])
  @@index([trashedAt])
  @@index([category, startAt])
  @@index([createdById, createdAt])
}

// Stage 5.7.2: source objects and variants are private until promotion.
model EventImage {
  id         String @id @db.VarChar(36)
  eventId    String
  storageKey String @db.VarChar(512)
  sortOrder  Int @default(0)
  caption    String? @db.VarChar(240)
  credit     String? @db.VarChar(240)
  rightsNote String? @db.VarChar(1000)
  createdAt  DateTime @default(now())

  event EventPost @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
}

// Stage 5.9.1: notices from verified administration; legacy Markdown is read-only.
enum OfficialNoticeStatus {
  DRAFT
  PUBLISHED
}

model OfficialNotice {
  id          String @id @default(cuid())
  slug        String @unique @db.VarChar(160)
  title       String @db.VarChar(200)
  date        String @db.VarChar(10)
  issuer      String @default("") @db.VarChar(240)
  locality    String @default("") @db.VarChar(200)
  summary     String @default("") @db.VarChar(600)
  sourceUrl   String @default("") @db.VarChar(2048)
  content     String @db.Text
  status      OfficialNoticeStatus @default(DRAFT)
  createdById String
  createdBy   User @relation("OfficialNoticeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?

  @@index([status, date])
  @@index([createdById, createdAt])
}

// Stage 5.9.2: normative documents. Legacy Markdown remains read-only.
enum OfficialDocumentStatus {
  DRAFT
  PUBLISHED
}

model OfficialDocument {
  id            String @id @default(cuid())
  slug          String @unique @db.VarChar(160)
  title         String @db.VarChar(300)
  type          String @db.VarChar(100)
  number        String @default("") @db.VarChar(100)
  date          String @db.VarChar(10)
  issuer        String @db.VarChar(240)
  description   String @default("") @db.Text
  sourceUrl     String @default("") @db.VarChar(2048)
  privatePdfKey String? @db.VarChar(512)
  publicPdfKey  String? @db.VarChar(512)
  status        OfficialDocumentStatus @default(DRAFT)
  createdById   String
  createdBy     User @relation("OfficialDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  publishedAt   DateTime?

  @@index([status, date])
  @@index([createdById, createdAt])
}

// Stage 5.9.3: city service alerts. Legacy Markdown remains read-only.
enum ServiceAlertStatus {
  DRAFT
  PUBLISHED
}

model ServiceAlert {
  id            String @id @default(cuid())
  slug          String @unique @db.VarChar(160)
  title         String @db.VarChar(200)
  service       String @db.VarChar(32)
  state         String @db.VarChar(24)
  urgency       String @default("normal") @db.VarChar(16)
  confirmed     Boolean @default(false)
  startAt       DateTime
  expectedEndAt DateTime?
  restoredAt    DateTime?
  addresses     String @default("") @db.VarChar(1000)
  source        String @default("") @db.VarChar(240)
  sourceUrl     String @default("") @db.VarChar(2048)
  content       String @default("") @db.Text
  status        ServiceAlertStatus @default(DRAFT)
  createdById   String
  createdBy     User @relation("ServiceAlertCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  publishedAt   DateTime?

  @@index([status, state, startAt])
  @@index([createdById, createdAt])
}

// Stage 5.14.1: CinemaWebApi read-only import; external IDs belong to one configured service.
model CinemaMovie {
  externalId      Int @id
  title           String @db.VarChar(180)
  story           String @default("") @db.Text
  durationMinutes Int?
  ageRating       String @default("") @db.VarChar(16)
  genres          String[] @default([])
  directors       String[] @default([])
  countries       String[] @default([])
  cast            String[] @default([])
  media           Json @default("[]")
  posterMediaId   Int?
  posterKey       String? @db.VarChar(512)
  posterHash      String? @db.VarChar(64)
  pzApiId         String? @db.VarChar(120)
  kinoplanId      Int?
  pushkinId       String? @db.VarChar(120)
  ticketPageUrl   String? @db.VarChar(2048)
  isCurrent       Boolean @default(true)
  lastSeenAt      DateTime @default(now()) @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  sessions        CinemaSession[]

  @@index([isCurrent, title])
}

model CinemaSession {
  externalId       Int @id
  movieExternalId  Int
  movie            CinemaMovie @relation(fields: [movieExternalId], references: [externalId], onDelete: Restrict)
  startAt          DateTime @db.Timestamptz(3)
  hallExternalId   Int?
  hallName         String @default("") @db.VarChar(120)
  formatName       String @default("") @db.VarChar(60)
  formatExternalId Int?
  prices           Json @default("[]")
  minPriceRub      Decimal? @db.Decimal(10, 2)
  locked           Boolean @default(false)
  deleted          Boolean @default(false)
  isEvent          Boolean @default(false)
  noSeats          Boolean @default(false)
  rentalLicense    Int?
  pushkinId        String? @db.VarChar(120)
  textCode         String @default("") @db.VarChar(40)
  verifiedPushkinId          String? @db.VarChar(120)
  pushkinVerifiedFingerprint String? @db.VarChar(64)
  pushkinProofNote           String? @db.VarChar(500)
  ticketUrl                  String? @db.VarChar(2048)
  ticketVerifiedFingerprint  String? @db.VarChar(64)
  listingReviewedById        String? @db.VarChar(100)
  listingReviewedAt          DateTime? @db.Timestamptz(3)
  isCurrent        Boolean @default(true)
  lastSeenAt       DateTime @default(now()) @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@index([isCurrent, startAt])
  @@index([movieExternalId, startAt])
}


// Stage 5.14.4: queued, audited automatic and manual cinema imports.
model CinemaSyncRun {
  id               String    @id @default(cuid())
  trigger          String    @db.VarChar(12)
  status           String    @default("QUEUED") @db.VarChar(16)
  requestedById    String?   @db.VarChar(100)
  movieCount       Int?
  sessionCount     Int?
  posterCandidates Int?
  posterUpdated    Int?
  posterUnchanged  Int?
  posterSkipped    Int?
  posterFailures   Int?
  posterFullScan   Boolean   @default(false)
  error            String?   @db.VarChar(1000)
  startedAt        DateTime? @db.Timestamptz(3)
  finishedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([status, createdAt])
}

// Stage 5.15.1: durable audit trail for reversible news/event trash operations.
model ContentTrashAudit {
  id        String   @id @default(cuid())
  kind      String   @db.VarChar(10)
  itemId    String   @db.VarChar(100)
  title     String   @db.VarChar(180)
  action    String   @db.VarChar(10)
  actorId   String   @db.VarChar(100)
  reason    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([kind, itemId, createdAt])
}

// Stage 5.15.2.2 — durable manual cleanup requests; no automatic worker.
model ContentPurgeRequest {
  id            String   @id @default(cuid())
  kind          String   @db.VarChar(10)
  itemId        String   @db.VarChar(100)
  title         String   @db.VarChar(180)
  trashedAt     DateTime @db.Timestamptz(3)
  requestedById String   @db.VarChar(100)
  reason        String   @db.VarChar(500)
  status        String   @default("PENDING") @db.VarChar(12)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  lastCheckedAt DateTime? @db.Timestamptz(3)
  lastCheck     Json?
  cancelledAt   DateTime? @db.Timestamptz(3)
  cancelledById String?  @db.VarChar(100)
  events        ContentPurgeRequestEvent[]
  plans         ContentPurgePlan[]

  @@unique([kind, itemId, trashedAt])
  @@index([status, createdAt])
  @@index([kind, itemId])
}

model ContentPurgeRequestEvent {
  id        String @id @default(cuid())
  requestId String
  actorId   String @db.VarChar(100)
  action    String @db.VarChar(12)
  note      String? @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  request ContentPurgeRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

// Stage 5.15.2.3.1: immutable manual dry-run plans, not purge approvals.
model ContentPurgePlan {
  id                String   @id @default(cuid())
  requestId         String
  kind              String   @db.VarChar(10)
  itemId            String   @db.VarChar(100)
  trashedAt         DateTime @db.Timestamptz(3)
  materialUpdatedAt DateTime @db.Timestamptz(3)
  requestUpdatedAt  DateTime @db.Timestamptz(3)
  actorId           String   @db.VarChar(100)
  status            String   @db.VarChar(12)
  digest            String   @db.VarChar(64)
  report            Json
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  request           ContentPurgeRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([kind, itemId])
}
