generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AdStatus {
  DRAFT
  PENDING
  APPROVED
  PUBLISHED
  REJECTED
  PAUSED
  CLOSED
  EXPIRED
}

model User {
  id    String   @id @default(cuid())
  email String?  @unique @db.VarChar(254)
  emailVerifiedAt DateTime?
  displayName String? @db.VarChar(80)
  phone String?  @unique @db.VarChar(24)
  role  UserRole @default(USER)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ads ClassifiedAd[]
  sessions UserSession[]
  newsPosts NewsPost[] @relation("NewsPostCreatedBy")
  newsWorkflowEvents NewsWorkflowEvent[] @relation("NewsWorkflowActor")
}

model ClassifiedAd {
  id   String  @id @default(cuid())
  slug String? @unique


  moderationReason String?   @db.VarChar(500)
  moderatedAt      DateTime?
  moderatedById    String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  title        String @db.VarChar(120)
  category     String @db.VarChar(32)
  description  String @db.Text
  priceRub     Int?
  location     String @db.VarChar(120)
  contactPhone String @db.VarChar(24)

  status AdStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  expiresAt   DateTime?
  closedAt    DateTime?

  photos AdPhoto[]

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([status, category])
}

model AdPhoto {
  id         String @id @default(cuid())
  adId       String
  storageKey String @db.VarChar(512)
  sortOrder  Int    @default(0)

  ad ClassifiedAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, sortOrder])
}
model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


// CMS: public news continues reading Markdown until the separate migration phase.
enum NewsStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  UNPUBLISHED
}

enum NewsWorkflowAction {
  SUBMITTED
  RETURNED
  APPROVED
  REOPENED
  PUBLISHED
  UNPUBLISHED
  REPUBLISHED
}

enum NewsSourceKind {
  OWN
  OFFICIAL
  PRESS_RELEASE
  THIRD_PARTY
  OTHER
}

model NewsPost {
  id             String     @id @default(cuid())
  slug           String     @unique @db.VarChar(160)
  title          String     @db.VarChar(180)
  summary        String     @default("") @db.VarChar(600)
  body           String     @db.Text
  status         NewsStatus @default(DRAFT)
  category       String     @default("город") @db.VarChar(48)
  authorName     String     @default("Редакция Поток 96") @db.VarChar(120)
  orgSlug        String?    @db.VarChar(160)
  tags           String[]   @default([])
  crosspost      String[]   @default([])
  cover          String?    @db.VarChar(512)
  featured       Boolean    @default(false)
  featuredOrder  Int        @default(99)
  sourceName     String?    @db.VarChar(180)
  sourceUrl      String?    @db.VarChar(2048)
  sourceText     String?    @db.Text
  sourceKind     NewsSourceKind @default(OWN)
  rightsNote     String?    @db.VarChar(2000)
  coverImageId   String?    @db.VarChar(36)
  images         NewsImage[]
  workflowEvents NewsWorkflowEvent[]
  createdById    String?
  createdBy      User?      @relation("NewsPostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  publishedAt    DateTime?

  @@index([status, publishedAt])
  @@index([updatedAt])
  @@index([createdById, createdAt])
}


// Private news draft images. Public CDN promotion happens in stage 5.3.
model NewsImage {
  id         String   @id @db.VarChar(36)
  postId     String
  storageKey String   @db.VarChar(512)
  sortOrder  Int      @default(0)
  caption    String?  @db.VarChar(240)
  credit     String?  @db.VarChar(240)
  rightsNote String?  @db.VarChar(1000)
  createdAt  DateTime @default(now())
  post       NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

// Record each editorial decision without publishing the article.
model NewsWorkflowEvent {
  id        String             @id @default(cuid())
  postId    String
  actorId   String?
  action    NewsWorkflowAction
  note      String?            @db.VarChar(1000)
  createdAt DateTime           @default(now())

  post      NewsPost           @relation(fields: [postId], references: [id], onDelete: Cascade)
  actor     User?              @relation("NewsWorkflowActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
}

// Immutable journal of administrator role changes. IDs remain after account deletion.
model AdminRoleChange {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String
  oldRole   UserRole
  newRole   UserRole
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([createdAt])
}

// Immutable audit of account session/grant revocations performed by ADMIN.
model AdminSessionRevocation {
  id           String   @id @default(cuid())
  actorId      String
  targetId     String
  revokedCount Int
  createdAt    DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([createdAt])
}

// A phone-only invitation does not give permissions until verified Mobile ID login.
// Keep audit IDs as strings, not foreign keys, for historical accuracy.
model StaffInvitation {
  id           String   @id @default(cuid())
  phone        String   @db.VarChar(24)
  createdById  String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?
  revokedAt    DateTime?
  acceptedById String?

  @@index([phone, createdAt])
  @@index([createdAt])
}

// Immutable audit of user archival/restoration; actor/target IDs outlive accounts.
model AdminUserArchive {
  id           String   @id @default(cuid())
  actorId      String
  targetId     String
  action       String   @db.VarChar(12)
  revokedCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([createdAt])
}

// Stage 5.6.1: PostgreSQL-backed organization cards; legacy Markdown remains read-only.
enum OrgStatus {
  DRAFT
  PUBLISHED
}

model Organization {
  id           String   @id @default(cuid())
  slug         String   @unique @db.VarChar(160)
  title        String   @db.VarChar(160)
  type         String   @default("") @db.VarChar(120)
  category     String   @default("other") @db.VarChar(32)
  area         String   @default("city") @db.VarChar(12)
  locality     String   @default("Красноуфимск") @db.VarChar(120)
  address      String   @default("") @db.VarChar(240)
  phone        String   @default("") @db.VarChar(100)
  hours        String   @default("") @db.VarChar(600)
  tags         String[] @default([])
  services     String[] @default([])
  website      String   @default("") @db.VarChar(2048)
  email        String   @default("") @db.VarChar(254)
  mapUrl       String   @default("") @db.VarChar(2048)
  vkUrl        String   @default("") @db.VarChar(2048)
  okUrl        String   @default("") @db.VarChar(2048)
  maxUrl       String   @default("") @db.VarChar(2048)
  logo         String   @default("") @db.VarChar(512)
  cover        String   @default("") @db.VarChar(512)
  logoImageId  String?  @db.VarChar(36)
  coverImageId String?  @db.VarChar(36)
  images       OrgImage[]
  content      String   @default("") @db.Text
  status       OrgStatus @default(DRAFT)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  publishedAt  DateTime?

  @@index([status, title])
  @@index([category, area])
}

// Stage 5.6.2: original and responsive versions are private until publication.
model OrgImage {
  id         String   @id @db.VarChar(36)
  orgId      String
  storageKey String   @db.VarChar(512)
  sortOrder  Int      @default(0)
  caption    String?  @db.VarChar(240)
  credit     String?  @db.VarChar(240)
  rightsNote String?  @db.VarChar(1000)
  createdAt  DateTime @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, sortOrder])
}
